#!/usr/bin/env bash
# One-time: copy .cursor AI layer → platform-ai/ SSOT, fix registry paths, run platform-ai-link
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

SSOT="platform-ai"

if [ -d "$SSOT/skills" ] && [ -n "$(find "$SSOT/skills" -name SKILL.md 2>/dev/null | head -1)" ]; then
  echo "platform-ai-migrate: SSOT already has skills — skip copy, run link only"
else
  echo "platform-ai-migrate: copying .cursor → $SSOT/"
  mkdir -p "$SSOT/skills" "$SSOT/rules" "$SSOT/extracts"
  [ -d .cursor/skills ] && cp -a .cursor/skills/. "$SSOT/skills/"
  [ -d .cursor/rules ] && cp -a .cursor/rules/. "$SSOT/rules/"
  [ -d .cursor/extracts ] && cp -a .cursor/extracts/. "$SSOT/extracts/"
  if [ -f "$SSOT/extracts/extract-registry.json" ]; then
    sed -i 's|\.cursor/extracts/|platform-ai/extracts/|g' "$SSOT/extracts/extract-registry.json"
  fi
fi

"$ROOT/scripts/platform-ai-link"
