#!/usr/bin/env bash
# Mirror platform-ai/ SSOT → .cursor/ (+ .kilo/ when present)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

SSOT="platform-ai"
REGISTRY_SRC="$SSOT/extracts/extract-registry.json"

mkdir -p "$SSOT/skills" "$SSOT/rules" "$SSOT/extracts"
mkdir -p .cursor/skills .cursor/rules .cursor/extracts

mirror_dir() {
  local src="$1" dst="$2"
  rm -rf "$dst"
  mkdir -p "$dst"
  if [ -d "$src" ] && [ -n "$(ls -A "$src" 2>/dev/null || true)" ]; then
    cp -a "$src/." "$dst/"
  fi
}

mirror_extracts() {
  local dst="$1"
  local prefix="$2"
  rm -rf "$dst"
  mkdir -p "$dst"
  if [ -d "$SSOT/extracts" ] && [ -n "$(ls -A "$SSOT/extracts" 2>/dev/null || true)" ]; then
    cp -a "$SSOT/extracts/." "$dst/"
    rm -f "$dst/extract-registry.json"
  fi
  if [ -f "$REGISTRY_SRC" ]; then
    sed "s|platform-ai/extracts/|${prefix}/|g" "$REGISTRY_SRC" > "$dst/extract-registry.json"
  fi
}

# --- Cursor ---
mirror_dir "$SSOT/skills" ".cursor/skills"
mirror_dir "$SSOT/rules" ".cursor/rules"
mirror_extracts ".cursor/extracts" ".cursor/extracts"

# --- Kilo (optional) ---
if [ -d ".kilo" ]; then
  mkdir -p .kilo/skills .kilo/instructions .kilo/extracts .kilo/command
  mirror_dir "$SSOT/skills" ".kilo/skills"
  mirror_dir "$SSOT/rules" ".kilo/instructions"
  mirror_extracts ".kilo/extracts" ".kilo/extracts"
  for d in "$SSOT/skills"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    cat > ".kilo/command/$name.md" << EOF
---
description: /$name — mirrored from platform-ai SSOT
agent: code
---
Run the \$name skill. Read and follow .kilo/skills/$name/SKILL.md (synced from platform-ai/skills/$name/SKILL.md).
Context files referenced inside that skill must be respected.
EOF
  done
fi

skill_count=$(find "$SSOT/skills" -name SKILL.md 2>/dev/null | wc -l)
rule_count=$(find "$SSOT/rules" -name '*.mdc' 2>/dev/null | wc -l)
extract_count=$(find "$SSOT/extracts" -type f ! -name 'extract-registry.json' 2>/dev/null | wc -l)

echo "platform-ai-link: OK (SSOT → mirror)"
echo "  SSOT: $SSOT/skills ($skill_count), rules ($rule_count), extracts ($extract_count files)"
echo "  .cursor: skills/, rules/, extracts/"
if [ -d ".kilo" ]; then
  echo "  .kilo: skills/, instructions/, extracts/, command/"
fi
echo "  (mirror paths are gitignored — commit platform-ai/ only)"
